    'M7.3 4.2 9.2 8c.3.6.1 1.3-.4 1.8l-1 1a12.5 12.5 0 0 0 5.4 5.4l1-1c.5-.5 1.2-.7 1.8-.4l3.8 1.9c.7.3 1.1 1.1.9 1.8l-.7 2.2c-.2.6-.8 1-1.5 1A16.5 16.5 0 0 1 2.3 5.5c0-.7.4-1.3 1-1.5l2.2-.7c.7-.2 1.5.2 1.8.9Z',
