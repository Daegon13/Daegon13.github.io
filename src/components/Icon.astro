    'M4 9h16',
    'M9 9v11',
  ],
  database: [
    'M5 6.5C5 4.6 8.1 3 12 3s7 1.6 7 3.5S15.9 10 12 10 5 8.4 5 6.5Z',
    'M5 6.5v5c0 1.9 3.1 3.5 7 3.5s7-1.6 7-3.5v-5',
    'M5 11.5v5c0 1.9 3.1 3.5 7 3.5s7-1.6 7-3.5v-5',
  ],
  settings: [
    'M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z',
    'M12 2.8v3',
    'M12 18.2v3',
    'M4.2 7.3l2.6 1.5',
    'M17.2 15.2l2.6 1.5',
    'M19.8 7.3l-2.6 1.5',
